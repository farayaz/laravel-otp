{
  "name": "farayaz/laravel-otp",
  "description": "simple otp for laravel",
  "authors": [
    {
      "name": "Mehrdad",
      "email": "mehrdad.motaghifar@gmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/container": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0"
  },
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Farayaz\\LaravelOtp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Farayaz\\LaravelOtp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Farayaz\\LaravelOtp\\LaravelOtpServiceProvider"
      ],
      "aliases": {
        "OTP": "Farayaz\\LaravelOtp\\LaravelOtpFacade"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint"
  }
}
